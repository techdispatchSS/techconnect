# Copy to .env and adjust as needed. Used by docker-compose.yml.

POSTGRES_DB=techconnect
POSTGRES_USER=techconnect
POSTGRES_PASSWORD=techconnect
# Host port for the containerised Postgres. If you also run PostgreSQL natively it will
# already own 5432 and silently shadow this container's published port — pick a free one
# (5434 works) rather than stopping your local service.
POSTGRES_PORT=5432

# Mailpit — local SMTP sink. Web UI at http://localhost:8025
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Backend (read by the Spring Boot app, not by docker-compose) ---

# HMAC signing key for self-issued JWTs (PRD FR-01/§9.2). Required — there is no default.
# Must be at least 32 bytes. Generate one with:  openssl rand -base64 48
# Every environment needs its own value; never reuse one across dev/staging/prod, and
# never commit a real one here — this file is version-controlled.
TECHCONNECT_JWT_SECRET=

# Base URL the activation/reset links point at (the frontend, not the API).
TECHCONNECT_APP_BASE_URL=http://localhost:4200

# Mail. Blank locally — Mailpit needs no credentials (see application-dev.properties, which
# also turns off SMTP auth/TLS for it). In a real deployment (SPRING_PROFILES_ACTIVE=prod),
# set these to a real provider's SMTP endpoint — e.g. AWS SES's SMTP interface — and
# TECHCONNECT_MAIL_FROM to an address/domain verified with that provider.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
TECHCONNECT_MAIL_FROM=no-reply@tech-connect.app

# First-run bootstrap Manager. On a fresh database, if no MANAGER exists the app creates
# this account in PENDING_ACTIVATION and logs an activation link at startup.
TECHCONNECT_BOOTSTRAP_ADMIN_EMAIL=admin@tech-connect.app
TECHCONNECT_BOOTSTRAP_ADMIN_NAME=TechConnect Admin

LOCALSTACK_PORT=4566
LOCALSTACK_DEBUG=0
AWS_REGION=us-east-1
# Required only for cognito-idp/cognito-identity (LocalStack Pro feature).
# Leave blank to run S3/SQS/SNS/SES on the free Community edition.
LOCALSTACK_AUTH_TOKEN=
